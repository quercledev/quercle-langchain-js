{
  "name": "@quercle/langchain",
  "version": "1.0.0",
  "description": "Quercle web tools for LangChain.js",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "knip": "knip",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "@quercle/sdk": "^1.0.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@langchain/core": ">=0.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@langchain/core": "^0.3.80",
    "@types/bun": "^1.3.8",
    "@types/node": "^22.19.7",
    "knip": "^5.82.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "quercle",
    "langchain",
    "ai",
    "search",
    "fetch",
    "web",
    "tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quercledev/quercle-langchain-js.git"
  },
  "homepage": "https://quercle.dev"
}
